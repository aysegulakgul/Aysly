{
  "name": "aysly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:check": "drizzle-kit check",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "verify": "node scripts/verify.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs",
      "cpu-features",
      "ssh2",
      "@parcel/watcher",
      "@swc/core"
    ]
  }
}
