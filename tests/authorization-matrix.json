{
  "$comment": "TESTING_STRATEGY §5: kendi /api/v1 uç noktalarımızın yetki matrisi. Her rota ve yöntem burada olmalıdır (scripts/route-matrix.mjs). access: public = oturum gerekmez; self = yalnızca aktörün kendi kaydı (başka kullanıcının kimliği istekte yer almaz); workspace = çalışma alanı kaynakları (başka kullanıcıya 404). sample: dinamik rotada sınanacak örnek yol.",
  "routes": [
    {
      "method": "POST",
      "path": "/api/v1/auth/sign-up",
      "access": "public"
    },
    {
      "method": "GET",
      "path": "/api/v1/me/preferences",
      "access": "self"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/me/preferences",
      "access": "self",
      "body": {
        "version": 1,
        "theme": "dark"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/v1/me",
      "access": "self",
      "body": {
        "name": "Ad"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/me/password",
      "access": "self",
      "body": {
        "currentPassword": "x",
        "newPassword": "y"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/me/email",
      "access": "self",
      "body": {
        "newEmail": "a@ornek.test",
        "currentPassword": "x"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/me/sessions",
      "access": "self"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/me/sessions",
      "access": "self",
      "sample": "/api/v1/me/sessions?others=true"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/me/sessions/[id]",
      "access": "self",
      "sample": "/api/v1/me/sessions/01900000-0000-7000-8000-000000000000"
    },
    {
      "method": "POST",
      "path": "/api/v1/me/onboarding",
      "access": "self",
      "body": {
        "intents": [],
        "createSamples": false
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/me/onboarding/skip",
      "access": "self",
      "body": {}
    },
    {
      "method": "POST",
      "path": "/api/v1/me/onboarding/restart",
      "access": "self",
      "body": {}
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/tasks",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks"
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks",
      "body": {
        "title": "x"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002",
      "body": {
        "version": 1
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/complete",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/complete",
      "body": {
        "version": 1
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/reopen",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/reopen",
      "body": {
        "version": 1
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces",
      "access": "self"
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/move",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/move",
      "body": {
        "version": 1,
        "projectId": "x"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/detach",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/detach",
      "body": {
        "version": 1
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/my-tasks",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/my-tasks"
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/projects",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/projects"
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/tags",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tags"
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/archive",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/archive",
      "body": {
        "version": 1
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]/unarchive",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002/unarchive",
      "body": {
        "version": 1
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/workspaces/[ws]/tasks/[id]",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/tasks/01900000-0000-7000-8000-000000000002"
    },
    {
      "method": "GET",
      "path": "/api/v1/workspaces/[ws]/trash",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/trash"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/workspaces/[ws]/trash",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/trash",
      "body": {
        "confirm": true
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/workspaces/[ws]/trash/restore",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/trash/restore",
      "body": {
        "batchId": "x"
      }
    },
    {
      "method": "DELETE",
      "path": "/api/v1/workspaces/[ws]/trash/[batchId]",
      "access": "workspace",
      "sample": "/api/v1/workspaces/01900000-0000-7000-8000-000000000001/trash/01900000-0000-7000-8000-000000000003",
      "body": {
        "confirm": true
      }
    },
    {
      "method": "PATCH",
      "path": "/api/v1/me/onboarding/checklist",
      "access": "self",
      "body": {
        "dismissed": true
      }
    }
  ]
}
