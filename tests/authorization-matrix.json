{
  "$comment": "TESTING_STRATEGY §5: kendi /api/v1 uç noktalarımızın yetki matrisi. Her rota ve yöntem burada olmalıdır (scripts/route-matrix.mjs). access: public = oturum gerekmez; self = yalnızca aktörün kendi kaydı (başka kullanıcının kimliği istekte yer almaz); workspace = çalışma alanı kaynakları (başka kullanıcıya 404). sample: dinamik rotada sınanacak örnek yol.",
  "routes": [
    {
      "method": "POST",
      "path": "/api/v1/auth/sign-up",
      "access": "public"
    },
    {
      "method": "GET",
      "path": "/api/v1/me/preferences",
      "access": "self"
    },
    {
      "method": "PATCH",
      "path": "/api/v1/me/preferences",
      "access": "self",
      "body": {
        "version": 1,
        "theme": "dark"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/v1/me",
      "access": "self",
      "body": {
        "name": "Ad"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/me/password",
      "access": "self",
      "body": {
        "currentPassword": "x",
        "newPassword": "y"
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/me/email",
      "access": "self",
      "body": {
        "newEmail": "a@ornek.test",
        "currentPassword": "x"
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/me/sessions",
      "access": "self"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/me/sessions",
      "access": "self",
      "sample": "/api/v1/me/sessions?others=true"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/me/sessions/[id]",
      "access": "self",
      "sample": "/api/v1/me/sessions/01900000-0000-7000-8000-000000000000"
    }
  ]
}
