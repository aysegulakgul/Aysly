# Bu dosyayı .env olarak kopyala. Değerler yalnızca yerel geliştirme içindir; gerçek gizli anahtar içermez.
NODE_ENV=development
DATABASE_URL=postgres://aysly:aysly_local_dev@127.0.0.1:5433/aysly
APP_BASE_URL=http://localhost:3000
# pnpm setup:env bu değeri rastgele üretir. Buraya gerçek anahtar yazma.
AUTH_SECRET=
LOG_LEVEL=info
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
EMAIL_FROM="Aysly <no-reply@aysly.local>"
SCHEDULER_ENABLED=true
